// Inspired by Catnap
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "none",
		"padding": {
			"top": 5,
			"right": 2
		}
	},
	"display": {
		"separator": " ",
		"key": {
			"width": 18
		}
	},
	"modules": [
		{
			"key": "╭─────────────╮",
			"type": "custom"
		},
		{
			// draw borders first to make colors of left and right border consistant
			"key": "│             │\u001b[13D{#36} user",
			"type": "title",
			"format": "{1}"
		},
		{
			"key": "├─────────────┤",
			"type": "custom"
		},
		{
			"key": "│             │\u001b[13D{#36}󰒋 hostname",
			"type": "title",
			"format": "{2}"
		},
		{
			"key": "│             │\u001b[13D{#36}󰅐 uptime",
			"type": "uptime"
		},
		{
                        "type": "command",
                        "key": "│             │\u001b[13D{#36}󰃭 OS Age",
                        "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install));            days_difference=$((time_progression / 86400)); echo $days_difference days"
                },
		{
			"key": "│             │\u001b[13D{#36}󰟾 distro",
			"type": "os"
		},
		{
			"key": "│             │\u001b[13D{#36} kernel",
			"type": "kernel"
		},
		{
			"key": "│             │\u001b[13D{#36} packages",
			"type": "packages"
		},
		{
			"key": "│             │\u001b[13D{#36} terminal",
			"type": "terminal"
		},
		{
			"key": "│             │\u001b[13D{#36} wm",
			"type": "wm"
		},
		{
			"key": "│             │\u001b[13D{#36} shell",
			"type": "shell"
		},
		{
			"key": "│             │\u001b[13D{#36} cpu",
			"type": "cpu",
			"showPeCoreCount": true
		},
        {
			"key": "│             │\u001b[13D{#36}󰢮 gpu",
			"type": "gpu"
		},
		{
			"key": "│             │\u001b[13D{#36}󰉉 disk",
			"type": "disk",
			"folders": "/"
		},
		{
			"key": "│             │\u001b[13D{#36} memory",
			"type": "memory"
		},
		{
			"key": "│             │\u001b[13D{#36}󰓡 swap",
			"type": "swap"
		},
		{
			"key": "├─────────────┤",
			"type": "custom"
		},
		{
			"key": "│             │\u001b[13D{#36} colors",
			"type": "colors",
			"symbol": "circle"
		},
		{
			"key": "╰─────────────╯",
			"type": "custom"
		}
	]
}
